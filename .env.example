# Optional LLM insights (OpenAI-compatible API)
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Residential proxy for sudrf Tier-1. Several comma-separated gateways are
# rotated round-robin, one per request.
# SUDRF_HTTP_PROXY=http://user:pass_country-RU@host:1000
# SUDRF_HTTP_PROXY=http://user:pass@host1:1000,http://user:pass@host2:1000

# Tier-1 HTTP reliability / politeness. Defaults shown; all optional.
# Retries on 429 / 5xx / dropped connections (0 disables retrying).
# SUDRF_MAX_RETRIES=3
# Exponential backoff with full jitter, in ms.
# SUDRF_RETRY_BASE_MS=800
# SUDRF_RETRY_CAP_MS=15000
# Upper bound on an honoured Retry-After header.
# SUDRF_MAX_RETRY_AFTER_MS=60000
# Minimum gap between two requests to the SAME court subdomain (0 disables).
# Different courts are unaffected and still run in parallel.
# SUDRF_MIN_INTERVAL_MS=250

# Catalog / RAG
# CATALOG_STORE_ACT_TEXT=0
# RAG_SAVE_DEBOUNCE_MS=8000

# Parser scope (optional federal subject code, e.g. 77)
# PARSER_REGION=
# DISPLAY_REGION=
